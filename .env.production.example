# Solution Advisor 生产环境变量模板。复制为 .env.production 后替换所有 change-me 值；
# .env.production 含 Secret，必须仅部署主机可读，不能提交 Git、日志或截图。
#
# 服务内生效优先级（低 → 高）：代码默认值 < 本文件（Compose env_file）<
# docker-compose*.yml 的 environment。生产 Compose 不应再额外覆盖安全配置。
# 本文件按业务域分段，段落顺序不改变上述优先级。

# 1. Compose 基础设施账户：仅供 postgres / minio 容器初始化使用。
POSTGRES_DB=solution_advisor
POSTGRES_USER=solution_advisor
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=solution-advisor
MINIO_ROOT_PASSWORD=change-me-minimum-8-chars

# 2. 控制面持久化、对象存储与迁移：API、migrate、common-analyzer 共用。
SOLUTION_ADVISOR_DATABASE_URL=postgresql+psycopg://solution_advisor:change-me@postgres:5432/solution_advisor
SOLUTION_ADVISOR_STORAGE_BACKEND=s3
SOLUTION_ADVISOR_S3_ENDPOINT_URL=http://minio:9000
SOLUTION_ADVISOR_S3_ACCESS_KEY_ID=solution-advisor
SOLUTION_ADVISOR_S3_SECRET_ACCESS_KEY=change-me-minimum-8-chars
SOLUTION_ADVISOR_S3_BUCKET=solution-advisor
SOLUTION_ADVISOR_S3_PREFIX=artifacts
SOLUTION_ADVISOR_AUTO_MIGRATE=false

# 3. 异步分析、上传和 Worker 内部注册。
SOLUTION_ADVISOR_REDIS_URL=redis://redis:6379/0
SOLUTION_ADVISOR_UPLOAD_TEMP_ROOT=/tmp/solution-advisor-receiving
SOLUTION_ADVISOR_UPLOAD_MAX_BYTES=268435456
# 与已安装 HostAgent 的 registration-token 文件必须一致；轮换时两端同步修改。
SOLUTION_ADVISOR_WORKER_REGISTRATION_TOKEN=development-worker-token
# 旧内部管理接口兼容项；不用于网页登录或 RBAC，请不要把它给用户。
SOLUTION_ADVISOR_ADMIN_TOKEN=admin

# 4. 身份总开关：生产测试身份必须关闭。
SOLUTION_ADVISOR_ENABLE_TEST_IDENTITIES=false

# 5. 内建本地超级管理员：用户名固定为 superadmin。
# 空库且尚无超级管理员时创建；密码只在创建时读取并以 scrypt 哈希保存。
SOLUTION_ADVISOR_LOCAL_AUTH_HMAC_KEY=change-me-a-different-long-random-local-auth-key
SOLUTION_ADVISOR_LOCAL_AUTH_ISSUER=solution-advisor-local
SOLUTION_ADVISOR_LOCAL_AUTH_AUDIENCE=solution-advisor
SOLUTION_ADVISOR_SUPERADMIN_PASSWORD=superadmin

# 6. 企业 SSO：当前版本的“受信任 JWT 适配”使用 issuer/audience/HMAC；关闭时网页不显示入口。
SOLUTION_ADVISOR_ENTERPRISE_SSO_ENABLED=false
SOLUTION_ADVISOR_IDENTITY_ISSUER=https://identity.example.internal
SOLUTION_ADVISOR_IDENTITY_AUDIENCE=solution-advisor
SOLUTION_ADVISOR_IDENTITY_HMAC_KEY=change-me-long-random-hmac-key
# 仅无任何超级管理员的首次 SSO 部署使用；之后通过受控交接管理最高权限。
SOLUTION_ADVISOR_IDENTITY_BOOTSTRAP_SUPER_SUBJECT=replace-with-initial-super-admin-subject

# 7. 企业 SSO/OIDC 与 JIT 预留配置：当前版本尚未实现 OIDC/SAML 重定向与 JIT，必须保持关闭。
# 保留这些键使生产文件结构完整；待确认公司 SSO 协议、群组 claim 和映射后才启用。
SOLUTION_ADVISOR_ENTERPRISE_SSO_JIT_ENABLED=false
SOLUTION_ADVISOR_ENTERPRISE_SSO_PROTOCOL=oidc
SOLUTION_ADVISOR_ENTERPRISE_SSO_SERVER_URL=
SOLUTION_ADVISOR_ENTERPRISE_SSO_CLIENT_ID=
SOLUTION_ADVISOR_ENTERPRISE_SSO_CLIENT_SECRET=
SOLUTION_ADVISOR_ENTERPRISE_SSO_REDIRECT_URI=
SOLUTION_ADVISOR_ENTERPRISE_SSO_GROUP_CLAIM=groups
SOLUTION_ADVISOR_ENTERPRISE_SSO_USER_GROUPS=
SOLUTION_ADVISOR_ENTERPRISE_SSO_ADMIN_GROUPS=
SOLUTION_ADVISOR_ENTERPRISE_SSO_SUPER_ADMIN_GROUPS=

# 8. Web 跨域：同域 Nginx 部署通常无需设置；分离前后端时填实际 Web Origin。
SOLUTION_ADVISOR_WEB_ORIGIN=
