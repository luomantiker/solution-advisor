# Solution Advisor 开发环境变量模板（复制为本机 .env，不提交）。
#
# 生效优先级（低 → 高）：代码默认值 < 本文件 env_file < docker-compose.yml 的 environment。
# docker-compose.yml 为开发场景强制启用测试身份，不能用本文件覆盖；生产请使用
# .env.production，不要把本文件或开发 Token 带入生产。

# 1. 持久化与对象存储：开发默认使用 SQLite + 本地文件。
SOLUTION_ADVISOR_DATABASE_URL=sqlite:///data/solution-advisor.sqlite3
SOLUTION_ADVISOR_STORAGE_BACKEND=local
SOLUTION_ADVISOR_STORAGE_ROOT=data/uploads
SOLUTION_ADVISOR_AUTO_MIGRATE=true

# 2. 异步分析与上传：docker-compose.yml 会把 Redis 地址改为 compose 服务名。
SOLUTION_ADVISOR_REDIS_URL=redis://localhost:6379/0
SOLUTION_ADVISOR_UPLOAD_TEMP_ROOT=data/receiving
SOLUTION_ADVISOR_UPLOAD_MAX_BYTES=268435456

# 3. 仅兼容旧内部接口的开发 Token；网页登录应使用显式测试身份或本地账号。
SOLUTION_ADVISOR_ADMIN_TOKEN=development-admin-token
